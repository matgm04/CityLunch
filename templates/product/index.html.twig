{% extends 'base.html.twig' %}

{% block title %}Menu du jour – CityLunch{% endblock %}

{% block body %}
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="fw-bold mb-0">Menu du jour</h1>
        <p class="text-muted">{{ "now"|date("l d F Y") }}</p>
    </div>
    {% if app.user %}
        <a href="{{ path('app_cart_index') }}" class="btn btn-outline-dark">
            <i class="bi bi-cart3"></i> Mon panier
            {% if app.user.cartItems|length > 0 %}
                <span class="badge bg-danger ms-1">{{ app.user.cartItems|length }}</span>
            {% endif %}
        </a>
    {% endif %}
</div>

{# ── Plats ────────────────────────────────────────────────────────────────── #}
{% if dishes|length > 0 %}
<h2 class="h4 mb-3 fw-semibold"><i class="bi bi-bowl-hot-fill text-warning"></i> Plats</h2>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">
    {% for product in dishes %}
        {{ _self.product_card(product) }}
    {% endfor %}
</div>
{% endif %}

{# ── Desserts ─────────────────────────────────────────────────────────────── #}
{% if desserts|length > 0 %}
<h2 class="h4 mb-3 fw-semibold"><i class="bi bi-cake2-fill text-pink" style="color:#e879a0"></i> Desserts</h2>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    {% for product in desserts %}
        {{ _self.product_card(product) }}
    {% endfor %}
</div>
{% endif %}

{% if dishes|length == 0 and desserts|length == 0 %}
    <div class="text-center py-5">
        <i class="bi bi-emoji-frown display-1 text-muted"></i>
        <p class="mt-3 text-muted fs-5">Aucun produit disponible pour le moment.</p>
    </div>
{% endif %}
{% endblock %}

{# ── Macro carte produit ──────────────────────────────────────────────────── #}
{% macro product_card(product) %}
<div class="col">
    <div class="card h-100 shadow-sm border-0">
        <div class="card-body d-flex flex-column">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title fw-semibold mb-0">{{ product.name }}</h5>
                <span class="badge bg-secondary badge-type ms-2">{{ product.typeLabel }}</span>
            </div>
            {% if product.description %}
                <p class="card-text text-muted small flex-grow-1">{{ product.description }}</p>
            {% endif %}
            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="fs-5 fw-bold" style="color:var(--cl-orange)">
                    {{ product.price|number_format(2, ',', ' ') }} €
                </span>
                {% if app.user %}
                    <form action="{{ path('app_cart_add', {id: product.id}) }}" method="post">
                        <input type="hidden" name="_token" value="{{ csrf_token('cart_add_' ~ product.id) }}">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-cart-plus"></i> Ajouter
                        </button>
                    </form>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn btn-outline-primary btn-sm">
                        <i class="bi bi-lock"></i> Connectez-vous
                    </a>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endmacro %}
