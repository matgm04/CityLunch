<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}CityLunch{% endblock %}</title>

    {# Bootstrap 5 CDN #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <style>
        :root {
            --cl-orange: #f97316;
            --cl-orange-dark: #ea580c;
        }
        .navbar-brand { font-weight: 800; color: var(--cl-orange) !important; }
        .btn-primary, .bg-primary { background-color: var(--cl-orange) !important; border-color: var(--cl-orange) !important; }
        .btn-primary:hover { background-color: var(--cl-orange-dark) !important; }
        .card { transition: transform .15s ease, box-shadow .15s ease; }
        .card:hover { transform: translateY(-3px); box-shadow: 0 8px 25px rgba(0,0,0,.12); }
        .badge-type { font-size: .7rem; }
        .cart-badge { position: relative; top: -8px; left: -6px; font-size: .65rem; }
    </style>

    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-light">

{# ── Navbar ──────────────────────────────────────────────────────────────── #}
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
    <div class="container">
        <a class="navbar-brand" href="{{ path('app_product_index') }}">
            <i class="bi bi-bag-heart-fill"></i> CityLunch
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_product_index') }}">
                        <i class="bi bi-grid-fill"></i> Menu du jour
                    </a>
                </li>
            </ul>

            <ul class="navbar-nav ms-auto">
                {% if app.user %}
                    {# Panier avec badge #}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_cart_index') }}">
                            <i class="bi bi-cart3 fs-5"></i>
                            {% if app.user.cartItems|length > 0 %}
                                <span class="badge rounded-pill bg-danger cart-badge">
                                    {{ app.user.cartItems|length }}
                                </span>
                            {% endif %}
                        </a>
                    </li>
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle"></i> {{ app.user.firstName }}
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text text-muted small">{{ app.user.email }}</span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item" href="{{ path('app_cart_index') }}">
                                    <i class="bi bi-cart3"></i> Mon panier
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item text-danger" href="{{ path('app_logout') }}">
                                    <i class="bi bi-box-arrow-right"></i> Déconnexion
                                </a>
                            </li>
                        </ul>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_login') }}">
                            <i class="bi bi-box-arrow-in-right"></i> Connexion
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link btn btn-sm ms-2" style="color:var(--cl-orange)" href="{{ path('app_register') }}">
                            <i class="bi bi-person-plus"></i> Créer un compte
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>

{# ── Flashes ─────────────────────────────────────────────────────────────── #}
<div class="container mt-3">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

{# ── Main ────────────────────────────────────────────────────────────────── #}
<main class="container my-4">
    {% block body %}{% endblock %}
</main>

<footer class="text-center text-muted py-4 mt-5 border-top small">
    &copy; {{ "now"|date("Y") }} CityLunch &mdash; Repas livrés chaque jour
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
