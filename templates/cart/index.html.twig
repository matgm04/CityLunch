{% extends 'base.html.twig' %}

{% block title %}Mon panier – CityLunch{% endblock %}

{% block body %}
<h1 class="fw-bold mb-4"><i class="bi bi-cart3"></i> Mon panier</h1>

{% if cartItems|length == 0 %}
    <div class="text-center py-5">
        <i class="bi bi-cart-x display-1 text-muted"></i>
        <p class="mt-3 fs-5 text-muted">Votre panier est vide.</p>
        <a href="{{ path('app_product_index') }}" class="btn btn-primary mt-2">
            <i class="bi bi-grid-fill"></i> Voir le menu
        </a>
    </div>
{% else %}
    <div class="row">
        {# ── Liste des articles ── #}
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body p-0">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Produit</th>
                                <th class="text-center">Qté</th>
                                <th class="text-end">Sous-total</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for item in cartItems %}
                            <tr>
                                <td>
                                    <div class="fw-semibold">{{ item.product.name }}</div>
                                    <small class="text-muted">{{ item.product.price|number_format(2, ',', ' ') }} € / unité</small>
                                </td>
                                <td class="text-center" style="width:160px">
                                    <form action="{{ path('app_cart_update', {id: item.id}) }}" method="post" class="d-flex align-items-center justify-content-center gap-1">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cart_update_' ~ item.id) }}">
                                        <button type="submit" name="quantity" value="{{ item.quantity - 1 }}" class="btn btn-outline-secondary btn-sm px-2">
                                            <i class="bi bi-dash"></i>
                                        </button>
                                        <span class="px-2 fw-semibold">{{ item.quantity }}</span>
                                        <button type="submit" name="quantity" value="{{ item.quantity + 1 }}" class="btn btn-outline-secondary btn-sm px-2">
                                            <i class="bi bi-plus"></i>
                                        </button>
                                    </form>
                                </td>
                                <td class="text-end fw-semibold" style="color:var(--cl-orange)">
                                    {{ item.subtotal|number_format(2, ',', ' ') }} €
                                </td>
                                <td class="text-end">
                                    <form action="{{ path('app_cart_remove', {id: item.id}) }}" method="post">
                                        <input type="hidden" name="_token" value="{{ csrf_token('cart_remove_' ~ item.id) }}">
                                        <button type="submit" class="btn btn-link text-danger btn-sm p-0" title="Supprimer">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <form action="{{ path('app_cart_clear') }}" method="post" onsubmit="return confirm('Vider le panier ?')">
                <input type="hidden" name="_token" value="{{ csrf_token('cart_clear') }}">
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-trash3"></i> Vider le panier
                </button>
            </form>
        </div>

        {# ── Récapitulatif ── #}
        <div class="col-lg-4 mt-4 mt-lg-0">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Récapitulatif</h5>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Articles ({{ cartItems|length }})</span>
                        <span>{{ total|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 text-muted small">
                        <span>Livraison</span>
                        <span>Gratuite</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between fw-bold fs-5">
                        <span>Total</span>
                        <span style="color:var(--cl-orange)">{{ total|number_format(2, ',', ' ') }} €</span>
                    </div>
                    <div class="mt-3 text-muted small text-center">
                        <i class="bi bi-info-circle"></i> La commande n'est pas encore implémentée.
                    </div>
                </div>
            </div>
            <a href="{{ path('app_product_index') }}" class="btn btn-outline-dark w-100 mt-3">
                <i class="bi bi-arrow-left"></i> Continuer mes achats
            </a>
        </div>
    </div>
{% endif %}
{% endblock %}
