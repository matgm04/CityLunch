{% extends 'base.html.twig' %}

{% block title %}Créer un compte – CityLunch{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-sm-10 col-md-8 col-lg-6">
        <div class="card shadow border-0 mt-3">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 fw-bold text-center mb-4">
                    <i class="bi bi-person-plus-fill" style="color:var(--cl-orange)"></i> Créer un compte
                </h1>

                {{ form_start(registrationForm) }}

                <div class="row mb-3">
                    <div class="col-sm-6">
                        {{ form_label(registrationForm.firstName, null, {label_attr: {class: 'fw-semibold'}}) }}
                        {{ form_widget(registrationForm.firstName, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(registrationForm.firstName) }}
                    </div>
                    <div class="col-sm-6">
                        {{ form_label(registrationForm.lastName, null, {label_attr: {class: 'fw-semibold'}}) }}
                        {{ form_widget(registrationForm.lastName, {attr: {class: 'form-control'}}) }}
                        {{ form_errors(registrationForm.lastName) }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.email, null, {label_attr: {class: 'fw-semibold'}}) }}
                    {{ form_widget(registrationForm.email, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(registrationForm.email) }}
                </div>

                <div class="mb-3">
                    {{ form_label(registrationForm.plainPassword.first, null, {label_attr: {class: 'fw-semibold'}}) }}
                    {{ form_widget(registrationForm.plainPassword.first, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(registrationForm.plainPassword.first) }}
                </div>

                <div class="mb-4">
                    {{ form_label(registrationForm.plainPassword.second, null, {label_attr: {class: 'fw-semibold'}}) }}
                    {{ form_widget(registrationForm.plainPassword.second, {attr: {class: 'form-control'}}) }}
                    {{ form_errors(registrationForm.plainPassword.second) }}
                    {{ form_errors(registrationForm.plainPassword) }}
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-person-check"></i> Créer mon compte
                </button>

                {{ form_end(registrationForm) }}

                <hr class="my-4">
                <p class="text-center text-muted mb-0">
                    Déjà un compte ?
                    <a href="{{ path('app_login') }}" class="fw-semibold" style="color:var(--cl-orange)">
                        Se connecter
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
